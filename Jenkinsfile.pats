pipeline {
    agent any
    environment {
        PORT = '8080'
        GOOGLE_CREDENTIALS_JSON = credentials('PATS_GOOGLE_CREDENTIALS')
        GOOGLE_SPREADSHEET_ID = credentials('PATS_GOOGLE_SPREADSHEET_ID')
        DOCKER_TAG = 'export-payments-pats'
        EXTERNAL_PORT = '8901'
        CRON_SCHEDULE="*/5 * * * *"
        MP_ACCESS_TOKEN = credentials('PATS_MP_ACCESS_TOKEN')
        MP_FETCH_LIMIT=100
        MP_BASE_URL="https://api.mercadopago.com"
    }
    stages {
        stage('Build') {
            steps {
                echo 'Building..'
                sh 'docker build -t $DOCKER_TAG .'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Stopping previous version...'
                sh 'docker stop $DOCKER_TAG || echo No hay nada que detener'
                sh 'docker rm $DOCKER_TAG || echo No hay nada que eliminar'
                echo 'Deploying....'
                sh 'docker run -d 
                    -e PORT=$PORT 
                    -e GOOGLE_CREDENTIALS_JSON=$GOOGLE_CREDENTIALS_JSON 
                    -e MP_BASE_URL=$MP_BASE_URL 
                    -e CRON_SCHEDULE=$CRON_SCHEDULE 
                    -e MP_FETCH_LIMIT=$MP_FETCH_LIMIT 
                    -e GOOGLE_SPREADSHEET_ID=$GOOGLE_SPREADSHEET_ID 
                    -e MP_ACCESS_TOKEN=$MP_ACCESS_TOKEN 
                    -p $EXTERNAL_PORT:8080 
                    --name $DOCKER_TAG 
                    $DOCKER_TAG'
            }
        }
    }
}